# StudyFreeEU — environment example
# Copy to .env and fill in. NEVER commit the real .env.

# ---- PostgreSQL / Supabase (optional: only needed for the dynamic backend) ----
# Local Postgres:
DATABASE_URL=postgres://postgres:password@localhost:5432/studyfreeeu
# Supabase (Settings -> Database -> Connection string -> URI):
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ---- Supabase client keys (only if you expose a Supabase-backed API) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Static build ----
# Output directory for scripts/build.mjs. Defaults to the managed project dir.
OUT_DIR=
